{
  "name": "xumu-creator-workspace",
  "version": "0.4.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run demo:export && playwright test",
    "demo:export": "npm run build && node scripts/export-preview.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "test:desktop": "node scripts/test-desktop.mjs",
    "desktop:dist": "npm run desktop:build && electron-builder --publish never",
    "desktop:prepare": "node node_modules/electron/install.js",
    "test:packaged": "playwright test -c playwright.packaged.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.59.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "main": "dist-desktop/desktop/main.js",
  "description": "序幕 Windows 桌面创作者工作台",
  "author": "Xumu Workspace",
  "license": "UNLICENSED"
}
